# AI export polish — OpenAI-compatible endpoint used by the in-app
# "AI Export Polish" feature. Copy to .env and fill in to bake defaults into
# the build; blank values just mean "no build-time default" (the Settings
# screen can still be filled in on the device). Never commit .env with a key.
#
# NEXT_PUBLIC_ prefix: Next.js only exposes these to the app bundle.

NEXT_PUBLIC_USER_LLM_BASE_URL=
NEXT_PUBLIC_USER_LLM_API_KEY=
NEXT_PUBLIC_USER_LLM_MODEL=qwen3.8-27b
